---
interface Props {
  title: string;
  url: string;
  image?: string;
  price?: number | string;
  area?: string;
  compact?: boolean;
}

const {
  title,
  url,
  image = '',
  price = '',
  area = '',
  compact = false,
} = Astro.props;

const formatPrice = (p: number | string) => {
  const n = typeof p === 'string' ? parseFloat(p) : p;
  if (!n || isNaN(n)) return '';
  if (n >= 1000000) return `${(n / 1000000).toFixed(2)} مليون جنيه`;
  if (n >= 1000) return `${Math.round(n / 1000)} ألف جنيه`;
  return `${n.toLocaleString('ar-EG')} جنيه`;
};

const priceText = formatPrice(price as number);

const shareText = `🏢 ${title}
${priceText ? `💰 السعر: ${priceText}` : ''}
${area ? `📍 الموقع: ${area}` : ''}

شاهد التفاصيل الكاملة على منصة عقار زين:
${url}

#عقار_زين #عقارات #الإسماعيلية`;

const encodedText = encodeURIComponent(shareText);
const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);

const shareLinks = {
  whatsapp: `https://wa.me/?text=${encodedText}`,
  facebook: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}&quote=${encodedTitle}`,
  telegram: `https://t.me/share/url?url=${encodedUrl}&text=${encodedTitle}`,
  twitter: `https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`,
};
---

<div class={`bg-white rounded-xl shadow-sm border border-gray-100 ${compact ? 'p-3' : 'p-4'}`} id={`share-${compact ? 'sidebar' : 'main'}`}>

  <h3 class={`font-bold text-gray-800 flex items-center gap-2 ${compact ? 'text-xs mb-2' : 'text-sm mb-3'}`}>
    <span class={`w-1 bg-blue-600 rounded ${compact ? 'h-3' : 'h-4'}`}></span>
    📤 {compact ? 'شارك' : 'شارك العقار'}
  </h3>

  <div class="grid grid-cols-3 gap-2">

    <a
      href={shareLinks.whatsapp}
      target="_blank"
      rel="noopener"
      class="flex flex-col items-center gap-1 py-2.5 px-2 bg-green-50 hover:bg-green-500 text-green-700 hover:text-white rounded-lg transition-all duration-200 border border-green-200 hover:border-green-500 hover:shadow-md"
      aria-label="مشاركة على واتساب"
    >
      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
      </svg>
      <span class="text-[10px] font-bold">واتساب</span>
    </a>

    <a
      href={shareLinks.facebook}
      target="_blank"
      rel="noopener"
      class="flex flex-col items-center gap-1 py-2.5 px-2 bg-blue-50 hover:bg-blue-600 text-blue-700 hover:text-white rounded-lg transition-all duration-200 border border-blue-200 hover:border-blue-600 hover:shadow-md"
      aria-label="مشاركة على فيسبوك"
    >
      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
        <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
      </svg>
      <span class="text-[10px] font-bold">فيسبوك</span>
    </a>

    <button
      type="button"
      data-copy-link
      data-url={url}
      class="flex flex-col items-center gap-1 py-2.5 px-2 bg-gray-50 hover:bg-gray-800 text-gray-700 hover:text-white rounded-lg transition-all duration-200 border border-gray-200 hover:border-gray-800 hover:shadow-md cursor-pointer"
      aria-label="نسخ الرابط"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
      </svg>
      <span class="text-[10px] font-bold" data-copy-label>نسخ</span>
    </button>

  </div>

  <div class="grid grid-cols-2 gap-2 mt-2">

    <a
      href={shareLinks.telegram}
      target="_blank"
      rel="noopener"
      class="flex items-center justify-center gap-1.5 py-2 px-2 bg-sky-50 hover:bg-sky-500 text-sky-700 hover:text-white rounded-lg transition-all duration-200 border border-sky-200 hover:border-sky-500 text-[11px] font-bold"
      aria-label="مشاركة على تيليجرام"
    >
      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
        <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
      </svg>
      تيليجرام
    </a>

    <a
      href={shareLinks.twitter}
      target="_blank"
      rel="noopener"
      class="flex items-center justify-center gap-1.5 py-2 px-2 bg-gray-50 hover:bg-black text-gray-700 hover:text-white rounded-lg transition-all duration-200 border border-gray-200 hover:border-black text-[11px] font-bold"
      aria-label="مشاركة على إكس"
    >
      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
      </svg>
      إكس
    </a>

  </div>

  <p data-copy-status class="hidden text-[11px] text-center mt-2 text-green-600 font-medium">
    ✅ تم نسخ الرابط بنجاح!
  </p>

</div>

<script>
  document.querySelectorAll('[data-copy-link]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const url = (btn as HTMLElement).dataset.url || window.location.href;
      const label = btn.querySelector('[data-copy-label]') as HTMLElement;
      const parent = btn.closest('[id^="share-"]') as HTMLElement;
      const status = parent?.querySelector('[data-copy-status]') as HTMLElement;

      try {
        await navigator.clipboard.writeText(url);
        if (label) {
          const original = label.textContent;
          label.textContent = 'تم!';
          setTimeout(() => { label.textContent = original; }, 2000);
        }
        if (status) {
          status.classList.remove('hidden');
          setTimeout(() => status.classList.add('hidden'), 2500);
        }
      } catch (err) {
        const input = document.createElement('input');
        input.value = url;
        document.body.appendChild(input);
        input.select();
        document.execCommand('copy');
        document.body.removeChild(input);
        if (status) {
          status.classList.remove('hidden');
          setTimeout(() => status.classList.add('hidden'), 2500);
        }
      }
    });
  });
</script>
