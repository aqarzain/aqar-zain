---
import SearchBar from './SearchBar.astro';

const currentPath = Astro.url.pathname;

const isActive = (path: string) => {
  if (path === '/aqar-zain/' || path === '/aqar-zain') {
    return currentPath === '/aqar-zain/' || currentPath === '/aqar-zain';
  }
  return currentPath.startsWith(path);
};

const navLinks = [
  { href: '/aqar-zain/', label: 'الرئيسية' },
  { href: '/aqar-zain/properties/', label: 'العقارات' },
  { href: '/aqar-zain/areas/', label: 'المناطق' },
  { href: '/aqar-zain/estimate/', label: 'تقدير السعر' },
  { href: '/aqar-zain/services/', label: 'خدماتنا' },
  { href: '/aqar-zain/about/', label: 'من نحن' },
  { href: '/aqar-zain/contact/', label: 'تواصل' },
];
---

<header class="bg-white shadow-sm sticky top-0 z-50 border-b border-gray-100">
  <div class="container mx-auto px-4">

    <!-- الشريط العلوي -->
    <div class="flex items-center justify-between h-14 md:h-16 gap-3">

      <!-- الشعار -->
      <a href="/aqar-zain/" class="flex items-center gap-2 group flex-shrink-0" aria-label="عقار زين - الرئيسية">
        <div class="w-9 h-9 md:w-10 md:h-10 bg-gradient-to-br from-blue-600 to-blue-800 rounded-lg flex items-center justify-center shadow-md group-hover:scale-105 transition-transform">
          <span class="text-lg md:text-xl">🏢</span>
        </div>
        <div class="leading-tight">
          <div class="text-sm md:text-base font-extrabold text-gray-800 group-hover:text-blue-600 transition">
            عقار زين
          </div>
          <div class="hidden md:block text-[10px] text-gray-500 font-medium">
            استثمارك في مكانه الصحيح
          </div>
        </div>
      </a>

      <!-- البحث (Desktop) -->
      <div class="hidden lg:block flex-1 max-w-md mx-4">
        <SearchBar compact={true} />
      </div>

      <!-- التنقل (Desktop) -->
      <nav class="hidden lg:flex items-center gap-0.5" aria-label="التنقل الرئيسي">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class={`relative px-2.5 py-2 rounded-lg text-xs font-medium transition ${
              isActive(link.href)
                ? 'text-blue-700 font-bold'
                : 'text-gray-700 hover:text-blue-600 hover:bg-gray-50'
            }`}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
            {isActive(link.href) && (
              <span class="absolute bottom-0 left-1/2 -translate-x-1/2 w-6 h-0.5 bg-blue-600 rounded-full"></span>
            )}
          </a>
        ))}
      </nav>

      <!-- زر واتساب (Desktop) -->
      <a
        href="https://wa.me/201281441854"
        target="_blank"
        rel="noopener"
        class="hidden lg:flex items-center gap-1.5 px-3 py-1.5 bg-green-600 hover:bg-green-700 text-white text-xs font-bold rounded-lg shadow-sm hover:shadow transition flex-shrink-0"
        aria-label="تواصل عبر واتساب"
      >
        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
        </svg>
        واتساب
      </a>

      <!-- زر القائمة (Mobile) -->
      <button
        id="mobile-menu-btn"
        class="lg:hidden w-9 h-9 flex items-center justify-center rounded-lg hover:bg-gray-100 transition flex-shrink-0"
        aria-label="القائمة"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="menu-icon-open" class="w-5 h-5 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <svg id="menu-icon-close" class="w-5 h-5 text-gray-700 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <!-- البحث (Mobile) -->
    <div class="lg:hidden pb-3">
      <SearchBar compact={true} />
    </div>

    <!-- قائمة الجوال -->
    <nav
      id="mobile-menu"
      class="hidden lg:hidden pb-3 border-t border-gray-100 pt-3"
      aria-label="التنقل الجوال"
    >
      {navLinks.map((link) => (
        <a
          href={link.href}
          class={`block px-3 py-2.5 rounded-lg text-xs font-medium transition mb-1 ${
            isActive(link.href)
              ? 'bg-blue-50 text-blue-700 font-bold border-r-2 border-blue-600'
              : 'text-gray-700 hover:bg-gray-50'
          }`}
        >
          {link.label}
        </a>
      ))}

      <a
        href="https://wa.me/201281441854"
        target="_blank"
        rel="noopener"
        class="flex items-center justify-center gap-2 mt-3 px-3 py-2.5 bg-green-600 hover:bg-green-700 text-white text-xs font-bold rounded-lg shadow-sm transition"
      >
        💬 تواصل عبر واتساب
      </a>
    </nav>

  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  btn?.addEventListener('click', () => {
    const isHidden = menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden', !isHidden);
    iconClose?.classList.toggle('hidden', isHidden);
    btn.setAttribute('aria-expanded', String(!isHidden));
  });

  // إغلاق القائمة عند تغيير الصفحة
  document.querySelectorAll('#mobile-menu a').forEach((link) => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      btn?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
