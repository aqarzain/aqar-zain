---
import type { PropertyMedia } from '../lib/api';
import { getPropertyIcon } from '../lib/api';

interface Props {
  media?: PropertyMedia[];
  category: string;
}

const { media = [], category } = Astro.props;
const icon = getPropertyIcon(category);
const hasMedia = media.length > 0;
---

<div class="space-y-4">
  <!-- Main Image -->
  <div class="relative bg-gradient-to-br from-primary-500 to-primary-700 rounded-2xl overflow-hidden h-96 md:h-[500px] flex items-center justify-center">
    {hasMedia ? (
      <img
        src={media[0].media_url}
        alt="صورة العقار"
        class="w-full h-full object-cover"
      />
    ) : (
      <span class="text-9xl">{icon}</span>
    )}

    <!-- Badge -->
    <div class="absolute top-4 right-4 bg-white/95 backdrop-blur px-4 py-2 rounded-lg shadow-lg">
      <span class="text-sm font-bold text-slate-800">صورة رئيسية</span>
    </div>
  </div>

  <!-- Thumbnails -->
  {hasMedia && media.length > 1 && (
    <div class="grid grid-cols-4 gap-3">
      {media.slice(0, 4).map((item) => (
        <div class="bg-slate-100 rounded-lg overflow-hidden h-24 cursor-pointer hover:opacity-80 transition">
          <img
            src={item.media_url}
            alt="صورة مصغرة"
            class="w-full h-full object-cover"
          />
        </div>
      ))}
    </div>
  )}
</div>
