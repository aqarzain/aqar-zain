---
interface Media {
  id: number;
  media_url: string;
  is_primary: boolean;
}

interface Property {
  id: number;
  title?: string;
  price?: number | string;
  area_sqm?: number | string;
  rooms?: number | null;
  bedrooms?: number;
  bathrooms?: number;
  category?: string;
  listing_type?: string;
  area_name?: string;
  city?: string;
  media?: Media[];
  views_count?: number;
  created_at?: string;
  is_featured?: boolean;
}

interface Props {
  property: Property;
  baseUrl?: string;
}

const { property, baseUrl = '/aqar-zain' } = Astro.props;

const toNum = (v: any) => {
  if (v === null || v === undefined) return 0;
  const n = typeof v === 'string' ? parseFloat(v) : v;
  return isNaN(n) ? 0 : n;
};

const formatPrice = (price?: number | string) => {
  const p = toNum(price);
  if (!p) return 'السعر عند الطلب';
  if (p >= 1000000) return `${(p / 1000000).toFixed(2)} مليون`;
  if (p >= 1000) return `${Math.round(p / 1000)} ألف`;
  return `${p.toLocaleString('ar-EG')} جنيه`;
};

const isValidImage = (url: string | undefined | null): boolean => {
  if (!url) return false;
  if (url.includes('placehold.co')) return false;
  if (url.trim() === '') return false;
  return true;
};

const getPrimaryImage = (): string | null => {
  if (!property.media || property.media.length === 0) return null;
  const primary = property.media.find((m) => m.is_primary) || property.media[0];
  return isValidImage(primary?.media_url) ? primary.media_url : null;
};

const getCategoryIcon = (cat?: string) => {
  const map: Record<string, string> = {
    'شقة': '🏢', 'منزل': '🏠', 'فيلا': '🏡',
    'محل': '🏪', 'أرض': '🌍', 'مكتب': '💼', 'مستودع': '📦',
  };
  return map[cat || ''] || '🏢';
};

// هل العقار جديد؟ (أقل من 7 أيام)
const isNew = (): boolean => {
  if (!property.created_at) return false;
  try {
    const days = (Date.now() - new Date(property.created_at).getTime()) / (1000 * 60 * 60 * 24);
    return days <= 7;
  } catch { return false; }
};

const detailUrl = `${baseUrl}/properties/${property.id}/`;
const imageUrl = getPrimaryImage();
const areaSqm = toNum(property.area_sqm);
const rooms = toNum(property.rooms) || toNum(property.bedrooms);
const bathrooms = toNum(property.bathrooms);
const views = toNum(property.views_count);
const categoryIcon = getCategoryIcon(property.category);
const isNewProperty = isNew();

// روابط المشاركة السريعة
const shareUrl = `https://aqarzain.github.io${detailUrl}`;
const shareText = encodeURIComponent(
  `🏢 ${property.title || 'عقار'}\n💰 ${formatPrice(property.price)}\n${shareUrl}`
);
const whatsappShare = `https://wa.me/?text=${shareText}`;
const facebookShare = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareUrl)}`;
---

<article class="group bg-white rounded-xl shadow-sm hover:shadow-lg transition-all duration-300 overflow-hidden border border-gray-100 hover:border-blue-200">

  <!-- الصورة -->
  <div class="relative aspect-[4/3] overflow-hidden">
    <a href={detailUrl} class="block">
      {imageUrl ? (
        <img
          src={imageUrl}
          alt={property.title || 'عقار'}
          loading="lazy"
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        />
      ) : (
        <div class="w-full h-full bg-gradient-to-br from-blue-500 to-blue-700 flex flex-col items-center justify-center text-white">
          <div class="text-6xl mb-2">{categoryIcon}</div>
          <div class="text-xs font-bold opacity-90">{property.category || 'عقار'}</div>
          <div class="text-[10px] opacity-70 mt-1">عقار زين</div>
        </div>
      )}

      <!-- شارة "جديد" -->
      {isNewProperty && (
        <span class="absolute top-2 right-2 px-2 py-0.5 bg-red-500 text-white text-[10px] font-bold rounded-full shadow-lg animate-pulse">
          ✨ جديد
        </span>
      )}

      <!-- شارة "مميز" -->
      {property.is_featured && !isNewProperty && (
        <span class="absolute top-2 right-2 px-2 py-0.5 bg-amber-500 text-white text-[10px] font-bold rounded-full shadow-lg">
          ⭐ مميز
        </span>
      )}

      <!-- نوع العرض -->
      <span class={`absolute top-2 left-2 px-2 py-0.5 text-white text-[10px] font-bold rounded-full shadow ${
        property.listing_type === 'إيجار' ? 'bg-green-600' : 'bg-blue-600'
      }`}>
        {property.listing_type === 'إيجار' ? 'للإيجار' : 'للبيع'}
      </span>

      <!-- عدد المشاهدات -->
      {views > 0 && (
        <span class="absolute bottom-2 left-2 flex items-center gap-0.5 px-1.5 py-0.5 bg-black/60 text-white text-[10px] rounded-full">
          👁 {views}
        </span>
      )}

      <!-- زر المشاركة السريع -->
      <div class="absolute bottom-2 right-2 flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
        <button
          type="button"
          onclick={`window.open('${whatsappShare}', '_blank')`}
          class="w-7 h-7 bg-green-600 hover:bg-green-700 text-white rounded-full flex items-center justify-center shadow-lg"
          aria-label="مشاركة على واتساب"
          title="مشاركة على واتساب"
        >
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
          </svg>
        </button>
        <button
          type="button"
          onclick={`window.open('${facebookShare}', '_blank')`}
          class="w-7 h-7 bg-blue-600 hover:bg-blue-700 text-white rounded-full flex items-center justify-center shadow-lg"
          aria-label="مشاركة على فيسبوك"
          title="مشاركة على فيسبوك"
        >
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
        </button>
      </div>
    </a>
  </div>

  <!-- المحتوى -->
  <div class="p-3">

    <a href={detailUrl} class="block">
      <h3 class="text-sm font-bold text-gray-800 mb-1.5 line-clamp-2 leading-5 h-10 group-hover:text-blue-600 transition">
        {property.title || `عقار رقم ${property.id}`}
      </h3>
    </a>

    {(property.area_name || property.city) && (
      <div class="flex items-center gap-1 text-xs text-gray-500 mb-2">
        <svg class="w-3 h-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
        <span class="line-clamp-1">
          {property.area_name || ''}{property.city ? ` - ${property.city}` : ''}
        </span>
      </div>
    )}

    <div class="flex items-center gap-2 text-[11px] text-gray-600 mb-2 pb-2 border-b border-gray-100">
      {areaSqm > 0 && <span>📐 {areaSqm}م²</span>}
      {rooms > 0 && <span>🛏 {rooms}</span>}
      {bathrooms > 0 && <span>🚿 {bathrooms}</span>}
    </div>

    <div class="flex items-center justify-between">
      <div>
        <p class="text-[10px] text-gray-400 leading-none mb-0.5">السعر</p>
        <p class="text-sm font-extrabold text-blue-600">
          {formatPrice(property.price)}
        </p>
      </div>
      <a
        href={detailUrl}
        class="flex items-center gap-1 text-[11px] font-bold text-blue-600 hover:text-white bg-blue-50 hover:bg-blue-600 px-2.5 py-1.5 rounded-lg transition"
      >
        التفاصيل
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
      </a>
    </div>

  </div>
</article>
