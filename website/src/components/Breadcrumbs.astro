---
interface BreadcrumbItem {
  href?: string;
  label: string;
}

interface Props {
  items: BreadcrumbItem[];
  variant?: 'hero' | 'light';
}

const { items = [], variant = 'hero' } = Astro.props;

// Schema.org BreadcrumbList
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    ...(item.href ? {
      item: `https://aqarzain.github.io${item.href}`,
    } : {}),
  })),
};
---

{/* Schema.org */}
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />

{/* Breadcrumbs */}
<nav
  aria-label="breadcrumb"
  class={`flex items-center gap-1.5 text-xs mb-3 flex-wrap ${
    variant === 'hero' ? 'text-blue-200' : 'text-gray-500'
  }`}
>
  {items.map((item, index) => (
    <>
      {item.href ? (
        <a
          href={item.href}
          class={`transition flex items-center gap-1 ${
            variant === 'hero'
              ? 'hover:text-white'
              : 'hover:text-blue-600'
          }`}
        >
          {index === 0 && (
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
            </svg>
          )}
          {item.label}
        </a>
      ) : (
        <span class={`font-medium line-clamp-1 ${
          variant === 'hero' ? 'text-white' : 'text-gray-800'
        }`}>
          {item.label}
        </span>
      )}
      {index < items.length - 1 && (
        <svg class={`w-3 h-3 flex-shrink-0 ${variant === 'hero' ? 'text-blue-300' : 'text-gray-400'}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
      )}
    </>
  ))}
</nav>
