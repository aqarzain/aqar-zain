---
interface Props {
  currentPage: number;
  totalPages: number;
  baseUrl: string;
  queryString?: string;
}

const { currentPage, totalPages, baseUrl, queryString = '' } = Astro.props;

const buildUrl = (page: number) => {
  const qs = queryString ? `?${queryString}&page=${page}` : `?page=${page}`;
  return `${baseUrl}${qs}`;
};

const getPageNumbers = () => {
  const pages: (number | string)[] = [];
  const maxVisible = 5;

  if (totalPages <= maxVisible) {
    for (let i = 1; i <= totalPages; i++) pages.push(i);
  } else {
    if (currentPage <= 3) {
      for (let i = 1; i <= 4; i++) pages.push(i);
      pages.push('...');
      pages.push(totalPages);
    } else if (currentPage >= totalPages - 2) {
      pages.push(1);
      pages.push('...');
      for (let i = totalPages - 3; i <= totalPages; i++) pages.push(i);
    } else {
      pages.push(1);
      pages.push('...');
      for (let i = currentPage - 1; i <= currentPage + 1; i++) pages.push(i);
      pages.push('...');
      pages.push(totalPages);
    }
  }
  return pages;
};

const pageNumbers = getPageNumbers();
---

{totalPages > 1 && (
  <nav class="flex items-center justify-center gap-1.5 mt-8" aria-label="ترقيم الصفحات">

    {currentPage > 1 ? (
      <a
        href={buildUrl(currentPage - 1)}
        class="flex items-center gap-1 px-3 py-1.5 rounded-lg bg-white border border-gray-200 hover:border-blue-500 hover:text-blue-600 text-gray-700 text-xs font-medium transition"
      >
        السابق
      </a>
    ) : (
      <span class="flex items-center gap-1 px-3 py-1.5 rounded-lg bg-gray-100 text-gray-400 text-xs font-medium cursor-not-allowed">
        السابق
      </span>
    )}

    <div class="flex items-center gap-1">
      {pageNumbers.map((page) => (
        typeof page === 'number' ? (
          <a
            href={buildUrl(page)}
            class={`w-8 h-8 flex items-center justify-center rounded-lg text-xs font-bold transition ${
              page === currentPage
                ? 'bg-blue-600 text-white shadow'
                : 'bg-white border border-gray-200 text-gray-700 hover:border-blue-500 hover:text-blue-600'
            }`}
          >
            {page}
          </a>
        ) : (
          <span class="w-8 h-8 flex items-center justify-center text-gray-400 text-xs font-bold">
            {page}
          </span>
        )
      ))}
    </div>

    {currentPage < totalPages ? (
      <a
        href={buildUrl(currentPage + 1)}
        class="flex items-center gap-1 px-3 py-1.5 rounded-lg bg-white border border-gray-200 hover:border-blue-500 hover:text-blue-600 text-gray-700 text-xs font-medium transition"
      >
        التالي
      </a>
    ) : (
      <span class="flex items-center gap-1 px-3 py-1.5 rounded-lg bg-gray-100 text-gray-400 text-xs font-medium cursor-not-allowed">
        التالي
      </span>
    )}

  </nav>
)}
