---
interface Props {
  phone?: string;
  message?: string;
}

const {
  phone = '201281441854',
  message = 'مرحباً، أريد الاستفسار عن عقار',
} = Astro.props;

const waUrl = `https://wa.me/${phone}?text=${encodeURIComponent(message)}`;
---

<div class="fixed bottom-4 right-4 md:bottom-6 md:right-6 z-40 flex flex-col items-end gap-2">

  <!-- Tooltip -->
  <div
    id="wa-tooltip"
    class="hidden md:block bg-white rounded-lg shadow-lg px-3 py-2 text-xs font-medium text-gray-700 whitespace-nowrap opacity-0 transition-opacity duration-300 border border-gray-100"
  >
    💬 تحدث معنا على واتساب
  </div>

  <!-- زر واتساب العائم -->
  <a
    id="wa-float"
    href={waUrl}
    target="_blank"
    rel="noopener"
    class="relative w-14 h-14 md:w-16 md:h-16 bg-gradient-to-br from-green-500 to-green-600 hover:from-green-600 hover:to-green-700 text-white rounded-full shadow-xl hover:shadow-2xl transition-all duration-300 flex items-center justify-center group hover:scale-110"
    aria-label="تواصل عبر واتساب"
    title="تواصل عبر واتساب"
  >
    <!-- حلقة النبض -->
    <span class="absolute inset-0 rounded-full bg-green-400 opacity-75 animate-ping"></span>

    <!-- الأيقونة -->
    <svg class="relative w-7 h-7 md:w-8 md:h-8" fill="currentColor" viewBox="0 0 24 24">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
    </svg>

    <!-- شارة -->
    <span class="absolute -top-1 -right-1 w-4 h-4 bg-red-500 rounded-full border-2 border-white text-[8px] font-bold flex items-center justify-center">1</span>
  </a>
</div>

<style>
  @keyframes ping {
    75%, 100% {
      transform: scale(1.6);
      opacity: 0;
    }
  }
  .animate-ping {
    animation: ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
</style>

<script>
  const tooltip = document.getElementById('wa-tooltip');
  const btn = document.getElementById('wa-float');

  if (tooltip && btn) {
    // إظهار الـ tooltip بعد 3 ثواني
    setTimeout(() => {
      tooltip.classList.remove('opacity-0');
      tooltip.classList.add('opacity-100');
    }, 3000);

    // إخفاء بعد 8 ثواني
    setTimeout(() => {
      tooltip.classList.add('opacity-0');
      tooltip.classList.remove('opacity-100');
    }, 8000);

    btn.addEventListener('mouseenter', () => {
      tooltip.classList.remove('opacity-0');
      tooltip.classList.add('opacity-100');
    });

    btn.addEventListener('mouseleave', () => {
      tooltip.classList.add('opacity-0');
      tooltip.classList.remove('opacity-100');
    });
  }
</script>
