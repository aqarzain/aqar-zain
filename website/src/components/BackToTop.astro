---
interface Props {
  threshold?: number;
}

const { threshold = 400 } = Astro.props;
---

<button
  id="back-to-top"
  type="button"
  data-threshold={threshold}
  class="fixed bottom-20 left-4 md:bottom-6 md:left-6 w-10 h-10 md:w-11 md:h-11 bg-blue-600 hover:bg-blue-700 text-white rounded-full shadow-lg hover:shadow-xl transition-all duration-300 opacity-0 pointer-events-none z-40 flex items-center justify-center group"
  aria-label="العودة للأعلى"
  title="العودة للأعلى"
>
  <svg class="w-4 h-4 md:w-5 md:h-5 group-hover:-translate-y-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 10l7-7m0 0l7 7m-7-7v18"/>
  </svg>
</button>

<script>
  const btn = document.getElementById('back-to-top');
  if (btn) {
    const threshold = parseInt(btn.dataset.threshold || '400');

    const toggleVisibility = () => {
      if (window.scrollY > threshold) {
        btn.classList.remove('opacity-0', 'pointer-events-none');
        btn.classList.add('opacity-100', 'pointer-events-auto');
      } else {
        btn.classList.add('opacity-0', 'pointer-events-none');
        btn.classList.remove('opacity-100', 'pointer-events-auto');
      }
    };

    btn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    window.addEventListener('scroll', toggleVisibility, { passive: true });
    toggleVisibility();
  }
</script>
