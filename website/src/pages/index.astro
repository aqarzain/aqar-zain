---
import BaseLayout from '../layouts/BaseLayout.astro';
import PropertyCard from '../components/PropertyCard.astro';

const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000';

const toNum = (v: any) => {
  if (v === null || v === undefined) return 0;
  const n = typeof v === 'string' ? parseFloat(v) : v;
  return isNaN(n) ? 0 : n;
};

let properties: any[] = [];
let stats = {
  total: 0,
  for_sale: 0,
  for_rent: 0,
  shops: 0,
  apartments: 0,
  villas: 0,
  lands: 0,
  avg_price: 0,
  min_price: 0,
  max_price: 0,
};
let areas: any[] = [];

try {
  const propsRes = await fetch(`${API_URL}/api/properties?limit=6&sort=newest`);
  if (propsRes.ok) {
    const data = await propsRes.json();
    properties = data.data || [];
  }
} catch (e) { console.error('فشل جلب العقارات:', e); }

try {
  const statsRes = await fetch(`${API_URL}/api/properties/stats`);
  if (statsRes.ok) {
    const data = await statsRes.json();
    const s = data.data || {};
    stats = {
      total: toNum(s.total),
      for_sale: toNum(s.for_sale),
      for_rent: toNum(s.for_rent),
      shops: toNum(s.shops),
      apartments: toNum(s.apartments),
      villas: toNum(s.villas),
      lands: toNum(s.lands),
      avg_price: toNum(s.avg_price),
      min_price: toNum(s.min_price),
      max_price: toNum(s.max_price),
    };
  }
} catch (e) { console.error('فشل جلب الإحصائيات:', e); }

try {
  const areasRes = await fetch(`${API_URL}/api/areas`);
  if (areasRes.ok) {
    const data = await areasRes.json();
    areas = (data.data || []).slice(0, 8);
  }
} catch (e) { console.error('فشل جلب المناطق:', e); }

const formatPrice = (p: number) => {
  if (p >= 1000000) return `${(p / 1000000).toFixed(1)} مليون`;
  if (p >= 1000) return `${Math.round(p / 1000)} ألف`;
  return `${p} جنيه`;
};
---

<BaseLayout
  title="عقار زين | منصة عقارية ذكية"
  description="منصة عقارية ذكية متكاملة - بيع وشراء وإيجار العقارات في الإسماعيلية ومصر"
>

  <!-- Hero Section -->
  <section class="bg-gradient-to-l from-blue-700 via-blue-600 to-blue-800 text-white">
    <div class="container mx-auto px-4 py-10 md:py-14">
      <div class="max-w-2xl mx-auto text-center">

        <div class="inline-block px-3 py-1 bg-white/10 backdrop-blur-sm rounded-full text-xs font-medium mb-4 border border-white/20">
          🏢 منصة عقارية ذكية
        </div>

        <h1 class="text-2xl md:text-3xl font-extrabold mb-3 leading-tight">
          عقار زين
        </h1>

        <p class="text-base md:text-lg font-semibold text-blue-100 mb-2">
          استثمارك دايماً في مكانه الصحيح
        </p>

        <p class="text-xs md:text-sm text-blue-200 mb-6 max-w-md mx-auto leading-6">
          اكتشف أفضل العقارات للبيع والإيجار في الإسماعيلية ومصر
        </p>

        <div class="flex flex-wrap gap-2 justify-center">
          <a
            href="/aqar-zain/properties/"
            class="bg-white text-blue-700 px-5 py-2.5 rounded-lg font-bold text-sm hover:bg-blue-50 transition shadow-md hover:shadow-lg"
          >
            🏠 تصفح العقارات
          </a>
          <a
            href="/aqar-zain/estimate/"
            class="bg-blue-500/30 backdrop-blur-sm border border-white/30 text-white px-5 py-2.5 rounded-lg font-bold text-sm hover:bg-blue-500/50 transition"
          >
            💰 قدّر سعر عقارك
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="bg-white border-b border-gray-100">
    <div class="container mx-auto px-4 py-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3">

        <div class="text-center p-3 bg-blue-50 rounded-xl border border-blue-100">
          <div class="text-xl mb-1">📊</div>
          <div class="text-xl font-extrabold text-blue-700">{stats.total}</div>
          <div class="text-[11px] text-gray-600 mt-0.5">عقار متاح</div>
        </div>

        <div class="text-center p-3 bg-green-50 rounded-xl border border-green-100">
          <div class="text-xl mb-1">🏷️</div>
          <div class="text-xl font-extrabold text-green-600">{stats.for_sale}</div>
          <div class="text-[11px] text-gray-600 mt-0.5">للبيع</div>
        </div>

        <div class="text-center p-3 bg-purple-50 rounded-xl border border-purple-100">
          <div class="text-xl mb-1">🏪</div>
          <div class="text-xl font-extrabold text-purple-600">{stats.shops}</div>
          <div class="text-[11px] text-gray-600 mt-0.5">محل</div>
        </div>

        <div class="text-center p-3 bg-amber-50 rounded-xl border border-amber-100">
          <div class="text-xl mb-1">💰</div>
          <div class="text-base font-extrabold text-amber-600">
            {formatPrice(stats.avg_price)}
          </div>
          <div class="text-[11px] text-gray-600 mt-0.5">متوسط السعر</div>
        </div>

      </div>
    </div>
  </section>

  <!-- Featured Properties -->
  <section class="py-8 bg-gray-50">
    <div class="container mx-auto px-4">

      <div class="flex items-end justify-between mb-5">
        <div>
          <h2 class="text-lg md:text-xl font-bold text-gray-800 mb-1 flex items-center gap-2">
            🏆 العقارات المميزة
          </h2>
          <p class="text-xs text-gray-500">أحدث العقارات المتاحة</p>
        </div>
        <a
          href="/aqar-zain/properties/"
          class="text-xs text-blue-600 hover:text-blue-700 font-bold flex items-center gap-1"
        >
          عرض الكل
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
        </a>
      </div>

      {properties.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {properties.map((property) => (
            <PropertyCard property={property} />
          ))}
        </div>
      ) : (
        <div class="text-center py-8 bg-white rounded-xl border border-gray-100">
          <div class="text-3xl mb-2">🏢</div>
          <p class="text-sm text-gray-500">لا توجد عقارات حالياً</p>
        </div>
      )}

    </div>
  </section>

  <!-- Areas Section -->
  {areas.length > 0 && (
    <section class="py-8 bg-white">
      <div class="container mx-auto px-4">

        <div class="flex items-end justify-between mb-5">
          <div>
            <h2 class="text-lg md:text-xl font-bold text-gray-800 mb-1 flex items-center gap-2">
              📍 تصفح حسب المنطقة
            </h2>
            <p class="text-xs text-gray-500">اكتشف العقارات في منطقتك</p>
          </div>
          <a
            href="/aqar-zain/areas/"
            class="text-xs text-blue-600 hover:text-blue-700 font-bold flex items-center gap-1"
          >
            كل المناطق
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
            </svg>
          </a>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
          {areas.map((area) => (
            <a
              href={`/aqar-zain/areas/${area.id}`}
              class="group bg-gray-50 rounded-lg border border-gray-100 p-3 hover:bg-blue-50 hover:border-blue-200 transition text-center"
            >
              <div class="text-xl mb-1">📍</div>
              <div class="text-xs font-bold text-gray-800 group-hover:text-blue-600 transition line-clamp-1">
                {area.name}
              </div>
            </a>
          ))}
        </div>

      </div>
    </section>
  )}

  <!-- CTA Section -->
  <section class="py-10 bg-gradient-to-l from-blue-700 via-blue-600 to-blue-800 text-white">
    <div class="container mx-auto px-4 text-center max-w-2xl">

      <h2 class="text-lg md:text-xl font-bold mb-2">هل تحتاج مساعدة؟</h2>
      <p class="text-xs md:text-sm text-blue-100 mb-5">
        فريقنا جاهز لمساعدتك في أي وقت
      </p>

      <div class="flex flex-wrap gap-2 justify-center">
        <a
          href="tel:01281441854"
          class="bg-white text-blue-700 px-5 py-2.5 rounded-lg font-bold text-sm hover:bg-blue-50 transition shadow-md"
        >
          📱 اتصل الآن
        </a>
        <a
          href="https://wa.me/201281441854"
          target="_blank"
          rel="noopener"
          class="bg-green-600 text-white px-5 py-2.5 rounded-lg font-bold text-sm hover:bg-green-700 transition shadow-md"
        >
          💬 واتساب
        </a>
      </div>

    </div>
  </section>

</BaseLayout>
